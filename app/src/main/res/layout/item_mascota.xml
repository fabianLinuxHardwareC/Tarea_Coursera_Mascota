<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:layout_marginBottom="12dp">



    <ImageView
        android:id="@+id/imageView"

        android:layout_width="match_parent"
        android:layout_height="200dp"

        android:scaleType="centerCrop"

        android:contentDescription="@string/imagen_mascota" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="@color/gris"
        android:padding="1dp">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:background="@color/blanco"
            android:padding="5dp">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="🦴"
                android:textSize="20sp" />



            <TextView
                android:id="@+id/textView"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:layout_marginStart="8dp"

                android:text="@string/armadillo"
                android:textColor="@color/negro"
                android:textSize="@dimen/tamano_texto" />


            <!-- PUNTUACION -->

            <TextView
                android:id="@+id/textoRating"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginEnd="8dp"

                android:text="5"
                android:textColor="@color/negro"
                android:textSize="@dimen/tamano_texto" />


            <!-- BOTON DE ME GUSTA -->

            <TextView
                android:id="@+id/botonHueso"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="🦴"
                android:textSize="20sp"

                android:contentDescription="@string/valorar_mascota"

                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>