<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <!-- BARRA SUPERIOR -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraFavoritos"

        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"

        android:background="@color/azul"

        app:title="@string/tool_menu_animales"
        app:titleTextColor="@color/blanco"

        app:navigationIcon="@drawable/ic_flecha_atras"
        app:navigationContentDescription="@string/volver"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- LISTA DE 5 MASCOTAS FAVORITAS -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:padding="12dp"
        android:clipToPadding="false"

        tools:listitem="@layout/item_mascota"
        tools:itemCount="5"

        app:layout_constraintTop_toBottomOf="@id/barraFavoritos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>